# ---------------------------------------------------------------------------
# LLM 后端
# 优先级：DEEPSEEK_API_KEY → LLM_BASE_URL（任意 OpenAI 兼容端点）→ 本地 Ollama
# ---------------------------------------------------------------------------

# 填上 key 就切到 DeepSeek；留空则继续用下面的 Ollama
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 自建 vLLM / 网关时改这两项（仅在 DEEPSEEK_API_KEY 为空时生效）
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_MODEL=Qwen2.5-7B-Instruct
# LLM_API_KEY=EMPTY

LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120

# ---------------------------------------------------------------------------
# 本地 Ollama（沿用 ollama_config.py 的原配置，未做删改）
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0.1

# 远程部署时的取值，需要时把上面两行注释掉、启用这两行：
# OLLAMA_BASE_URL=http://your-server:11434
# OLLAMA_MODEL=qwen2.5:7b

# ---------------------------------------------------------------------------
# 执行器：local = 本机 python 直接跑；docker = 进容器跑（原实现只有这一种）
# ---------------------------------------------------------------------------
RUNNER=local
# PYTHON_BIN=python3
# DOCKER_SHM=8G

# ---------------------------------------------------------------------------
# 外部服务（内网地址，按需填；不填则相关步骤自动降级）
#   DATA_SERVER_URL          数据下载服务，不填则复用 ai_data/ftp_data 里的已有数据
#   PREANNOTATION_SERVER_URL VLM 预标注服务，不填则直接走人工标注（人在回路）
# ---------------------------------------------------------------------------
# DATA_SERVER_URL=http://your-server:8000
# PREANNOTATION_SERVER_URL=http://your-server:8001

# 没配 DATA_SERVER_URL 时，本地数据与任务名不匹配要不要直接拒绝。
# 0 = 只警告继续（默认）；1 = 拒绝，避免 A 任务用 B 任务的数据训练。
DATA_REUSE_STRICT=0

# ---------------------------------------------------------------------------
# 路径（默认都在项目内，一般不用改）
# ---------------------------------------------------------------------------
# FCOS_DIR=fcos
# AFTERMARKET_DATA_PATH=data/aftermarket_data
# TRAINING_LOGS_DIR=data/training_logs
# IMG_DIR=ai_data/images
# IMG_WITH_LABEL_DIR=ai_data/images_with_label
# FRAME_FPS=5
# FRAME_RESOLUTION=1280x720
